environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt5ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    LANG "zh_CN.UTF-8"
    LANGUAGE "zh_CN:en_US"
    LC_ALL "zh_CN.UTF-8"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    PROTON_ENABLE_WAYLAND "1"

    QT_IM_MODULE "fcitx"
    QT_IM_MODULES "wayland;fcitx;ibus"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
}

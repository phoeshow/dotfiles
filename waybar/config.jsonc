{
  "spacing": 0,
  "modules-left": ["niri/workspaces"],
  "modules-center": [],
  "modules-right": ["pulseaudio", "cpu", "memory", "network", "clock", "tray", "group/system"],

  "group/system": {
    "orientation": "horizontal",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": ["custom/power", "custom/wallpaper", "idle_inhibitor"],
  },
  "custom/wallpaper": {
    "format": "",
    "tooltip": false,
    "on-click": "sh $HOME/.config/rofi/wallpaper/wallpaper.sh",
  },
  "custom/power": {
    "format": "",
    "on-click": "sh $HOME/.config/rofi/powermenu/powermenu.sh",
    "tooltip": false,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰒳",
      "deactivated": "󰒲",
    },
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
    },
  },

  "clock": {
    "format": " {:%H:%M}",
    "locale": "C",
    "format-alt": "󰃮 {:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#89b4fa'><b>{}</b></span>",
        "days": "<span color='#bac2de'>{}</span>",
        "weeks": "<span color='#7851a9'><b>W{}</b></span>",
        "weekdays": "<span color='#89dceb'><b>{}</b></span>",
        "today": "<span color='#eba0ac'><b><u>{}</u></b></span>",
      },
    },
  },

  "cpu": {
    "interval": 10,
    "format": " {usage}%",
  },
  "memory": {
    "format": " {percentage}%",
  },

  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-muted": "󰍷 {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 {icon}",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰥰",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰄝",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
  },

  "network": {
    "format-wifi": " {bandwidthDownBytes}  ",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "Disconnected  ",
    "format-alt": " {bandwidthUpBytes}| {bandwidthDownBytes}",
    "tooltip-format": "{ifname}: {ipaddr}",
    "interval": 5,
  },
  "tray": {
    "icon-size": 14,
    "spacing": 6,
  },
}
